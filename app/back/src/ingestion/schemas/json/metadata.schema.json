        },
        "effective_date": {
          "$ref": "#/$defs/DocumentField"
        },
        "publication_date": {
          "$ref": "#/$defs/DocumentField"
        },
        "title": {
          "$ref": "#/$defs/DocumentField"
        },
        "version": {
          "$ref": "#/$defs/DocumentField"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
