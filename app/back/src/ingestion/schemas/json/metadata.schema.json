        "type": "string"
      },
      "title": "Review Reasons",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_hash": {
      "title": "Source Hash",
      "type": "string"
    },
    "source_relpath": {
      "title": "Source Relpath",
      "type": "string"
    },
    "tables": {
      "$ref": "#/$defs/Observation"
