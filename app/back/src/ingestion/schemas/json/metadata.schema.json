      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legacy Source Path"
    },
    "normalized_relpath": {
      "title": "Normalized Relpath",
      "type": "string"
    },
    "ocr_confidence": {
      "$ref": "#/$defs/ConfidenceMetric"
    },
    "page_count": {
      "minimum": 0,
      "title": "Page Count",
      "type": "integer"
    },
    "pipeline_version": {
      "title": "Pipeline Version",
      "type": "string"
    },
    "processed_at": {
      "title": "Processed At",
      "type": "string"
    },
