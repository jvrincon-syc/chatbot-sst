        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "content_prediction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Prediction"
        },
        "document_type": {
          "enum": [
            "manual",
            "formulario",
            "politica",
            "reglamento",
            "programa",
            "matriz",
            "procedimiento",
            "anexo",
            "instructivo",
            "capacitacion",
            "acta",
            "norma",
            "guia",
            "informacion_general",
            "otro"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "document_type_confidence": {
          "$ref": "#/$defs/ConfidenceMetric"
        },
        "route_prior": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Prior"
        },
        "signals": {
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "topic_confidence": {
          "$ref": "#/$defs/ConfidenceMetric"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "document_type",
        "document_type_confidence",
        "topic",
        "topic_confidence"
      ],
      "title": "Classification",
      "type": "object"
    },
    "ConfidenceMetric": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "engine_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
