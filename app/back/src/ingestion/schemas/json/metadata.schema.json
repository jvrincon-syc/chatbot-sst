  "required": [
    "schema_version",
    "document_id",
    "document_name",
    "source_relpath",
    "normalized_relpath",
    "document_control",
    "classification",
    "page_count",
    "extraction_method",
    "ocr_confidence",
    "handwriting",
    "tables",
    "forms",
    "source_hash",
    "corpus_version",
    "pipeline_version",
    "processing_status"
