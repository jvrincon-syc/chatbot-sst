{
  "$defs": {
    "ArtifactHash": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "relpath": {
          "title": "Relpath",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "relpath",
        "sha256",
        "byte_size"
      ],
      "title": "ArtifactHash",
      "type": "object"
    },
    "BundleManifest": {
      "additionalProperties": false,
      "properties": {
        "artifact_hashes": {
          "items": {
            "$ref": "#/$defs/ArtifactHash"
          },
          "title": "Artifact Hashes",
          "type": "array"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_status": {
          "enum": [
            "pending",
            "processed",
            "failed",
            "needs_review"
          ],
          "title": "Document Status",
          "type": "string"
        },
        "normalized_base": {
          "title": "Normalized Base",
          "type": "string"
        },
        "processing_fingerprint": {
          "minLength": 1,
          "title": "Processing Fingerprint",
          "type": "string"
        },
        "required_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Required Artifacts",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_relpath": {
          "title": "Source Relpath",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "document_id",
        "source_relpath",
        "source_hash",
        "normalized_base",
        "required_artifacts",
        "artifact_hashes",
        "processing_fingerprint",
        "document_status"
      ],
      "title": "BundleManifest",
      "type": "object"
    },
    "RunDocument": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "processed",
            "reprocessed",
            "reused",
            "failed",
            "needs_review"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_status": {
          "enum": [
            "pending",
            "processed",
            "failed",
            "needs_review"
          ],
          "title": "Document Status",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_relpath": {
          "title": "Source Relpath",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "document_id",
        "source_relpath",
        "document_status",
        "disposition"
      ],
      "title": "RunDocument",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundles": {
      "items": {
        "$ref": "#/$defs/BundleManifest"
      },
      "title": "Bundles",
      "type": "array"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/RunDocument"
      },
      "title": "Documents",
      "type": "array"
    },
    "fingerprints": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Fingerprints",
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Summary",
      "type": "object"
    },
    "timestamp": {
      "minLength": 1,
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "timestamp",
    "fingerprints",
    "summary",
    "documents",
    "bundles"
  ],
  "title": "RunManifest",
  "type": "object"
}
