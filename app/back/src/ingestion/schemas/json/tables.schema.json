{
  "$defs": {
    "TableRecord": {
      "properties": {
        "table_id": {
          "title": "Table Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "headers": {
          "items": {
            "type": "string"
          },
          "title": "Headers",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "markdown_representation": {
          "title": "Markdown Representation",
          "type": "string"
        },
        "quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality",
          "type": "number"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "table_id",
        "page_number",
        "markdown_representation",
        "quality"
      ],
      "title": "TableRecord",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "table_count": {
      "minimum": 0,
      "title": "Table Count",
      "type": "integer"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/TableRecord"
      },
      "title": "Tables",
      "type": "array"
    }
  },
  "required": [
    "document_id",
    "table_count",
    "tables"
  ],
  "title": "TablesArtifact",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
