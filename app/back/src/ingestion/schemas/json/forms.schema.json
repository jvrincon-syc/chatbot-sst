            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
