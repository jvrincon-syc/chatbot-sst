        "$ref": "#/$defs/Observation"
      },
      "title": "Page Observations",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "document_id"
  ],
  "title": "FormsArtifact",
  "type": "object"
}
