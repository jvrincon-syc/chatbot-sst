# Copy this file to secrets.env and adjust local values.
# Do not put API keys in git.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_sst
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres@localhost:5432/chatbot_sst

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# OCR / ingestion
OCR_TEMP_DIR=/private/tmp/chatbot-sst-ocr
OCR_KEEP_TEMP=false
OCR_LOW_CONFIDENCE_THRESHOLD=0.70
OCR_TIMEOUT_SECONDS=180
TESSERACT_CMD=tesseract
TESSERACT_LANGUAGE=spa
OCRMYPDF_CMD=ocrmypdf

# Future providers. Keep empty until configured locally.
OPENAI_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=
