{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Llama-first smoke result",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "document_id", "capabilities"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["skipped", "passed", "failed", "blocked"] },
    "document_id": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["parse", "classify", "extract"] }
    },
    "provider_job_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "credits": { "type": "number", "minimum": 0 },
    "elapsed_seconds": { "type": "number", "minimum": 0 },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
