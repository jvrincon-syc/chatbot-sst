+def test_structure_aware_parser_creates_one_parent_per_catalog_page() -> None:
+    nodes = StructureAwareNodeParser(max_child_chars=32).parse(_document())
+
+    parent_nodes = [node for node in nodes if node.metadata["node_role"] == "parent"]
+
+    assert len(parent_nodes) == 2
+    assert [node.metadata["page_number"] for node in parent_nodes] == [1, 2]
+    assert [node.metadata["parent_node_id"] for node in parent_nodes] == [None, None]
+
+
+def test_structure_aware_parser_does_not_overlap_consecutive_child_chunks() -> None:
+    nodes = StructureAwareNodeParser(max_child_chars=32).parse(_document())
+    child_nodes = [node for node in nodes if node.metadata["node_role"] == "child"]
+
+    assert all("overlap" not in node.metadata for node in child_nodes)
+    for previous, current in zip(child_nodes, child_nodes[1:]):
+        if previous.metadata["parent_node_id"] == current.metadata["parent_node_id"]:
+            assert current.metadata["char_start"] >= previous.metadata["char_end"]
