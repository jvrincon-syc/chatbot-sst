      "_note": "Root '# Manual SST' has no body and is merged into '## Objetivo'. Two '##' sections -> 2 parents.",
      "expected": {
        "parent_count": 2,
        "child_count_min": 2,
        "tables_present": false,
        "forms_present": false,
        "ocr_present": false,
        "any_parent_cross_page": false
      }
    },
    {
